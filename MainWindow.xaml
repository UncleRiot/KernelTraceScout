<Window
    x:Class="KernelTraceScout.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KernelTraceScout"
    Title="KernelTraceScout - Kernel CPU Diagnostics">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Padding="12,6" ColumnDefinitions="*,Auto" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="KernelTraceScout" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="0.9.1" VerticalAlignment="Center" Opacity="0.55" />
            </StackPanel>
            <Button x:Name="ThemeButton"
                    Grid.Column="1"
                    Click="Theme_Click"
                    Width="36"
                    Height="36"
                    Padding="4"
                    MinWidth="36"
                    MinHeight="36"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Switch light / dark mode"
                    AutomationProperties.Name="Toggle light and dark mode">
                <FontIcon x:Name="ThemeGlyph" Glyph="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="18" />
            </Button>
        </Grid>

        <NavigationView x:Name="Navigator"
                        Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        CompactPaneLength="40"
                        OpenPaneLength="220"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Processes" Tag="Processes" Icon="ViewAll" />
                <NavigationViewItem Content="Cause &amp; Effect" Tag="CauseEffect" Icon="Link" />
                <NavigationViewItem Content="Filter-Drivers" Tag="Filters" Icon="List" />
                <NavigationViewItem Content="Driver / Stack Analysis" Tag="Drivers" Icon="Find" />
                <NavigationViewItem Content="Help" Tag="Help" Icon="Help" />
                <NavigationViewItem Content="About" Tag="About" Icon="Contact" />
            </NavigationView.MenuItems>

            <Grid Padding="8" RowDefinitions="Auto,*,Auto">
                <Border Grid.Row="0"
                        Padding="8"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="6">
                        <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                            <AppBarButton x:Name="CaptureButton" Icon="Find" Label="Analyze (ETW)" Click="Capture_Click" />
                            <AppBarButton x:Name="CheckButton" Icon="Accept" Label="Check once" Click="Check_Click" />
                            <AppBarButton x:Name="AutoButton" Icon="Play" Label="Auto refresh" Click="Auto_Click" />
                            <AppBarButton x:Name="FiltersButton" Icon="Refresh" Label="Refresh" Visibility="Collapsed" Click="Filters_Click" />
                            <AppBarButton x:Name="ExportButton" Icon="Save" Label="Export CSV" Click="Export_Click" />
                            <AppBarButton x:Name="DemoButton" Icon="Preview" Label="Demo" Click="Demo_Click" />
                        </CommandBar>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Kernel CPU limit (%):" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <NumberBox x:Name="Threshold" Minimum="1" Maximum="99" Value="5" Width="68" SpinButtonPlacementMode="Hidden" />
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <RepeatButton Width="19" Height="17" Padding="0" FontSize="10" Content="▲" Tag="Threshold" Click="IncrementSetting_Click" />
                                        <RepeatButton Width="19" Height="17" Padding="0" FontSize="10" Content="▼" Tag="Threshold" Click="DecrementSetting_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Refresh interval (s):" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <NumberBox x:Name="RefreshInterval" Minimum="1" Maximum="300" Value="2" Width="68" SpinButtonPlacementMode="Hidden" />
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <RepeatButton Width="19" Height="17" Padding="0" FontSize="10" Content="▲" Tag="RefreshInterval" Click="IncrementSetting_Click" />
                                        <RepeatButton Width="19" Height="17" Padding="0" FontSize="10" Content="▼" Tag="RefreshInterval" Click="DecrementSetting_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Capture duration (s):" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <NumberBox x:Name="CaptureDuration" Minimum="5" Maximum="120" Value="30" Width="68" SpinButtonPlacementMode="Hidden" />
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <RepeatButton Width="19" Height="17" Padding="0" FontSize="10" Content="▲" Tag="CaptureDuration" Click="IncrementSetting_Click" />
                                        <RepeatButton Width="19" Height="17" Padding="0" FontSize="10" Content="▼" Tag="CaptureDuration" Click="DecrementSetting_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <ProgressBar x:Name="CaptureProgress" Width="240" Minimum="0" Maximum="100" Visibility="Collapsed" />
                            <TextBlock x:Name="CaptureProgressText" Visibility="Collapsed" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,6,0,6">
                    <ListView x:Name="ProcessList" FontSize="12" Visibility="Visible">
                        <ListView.Header>
<Grid Padding="6,4" ColumnSpacing="12" ColumnDefinitions="175,58,80,91,80,79,215,*">
    <Button Grid.Column="0" Tag="process:Name" Content="PROCESS" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
    <Button Grid.Column="1" Tag="process:Pid" Content="PID" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
    <Button Grid.Column="2" Tag="process:Cpu" Content="TOTAL CPU" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
    <Button Grid.Column="3" Tag="process:Kernel" Content="KERNEL CPU" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
    <Button Grid.Column="4" Tag="process:User" Content="USER CPU" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
    <Button Grid.Column="5" Tag="process:Ratio" Content="K/U RATIO" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
    <Button Grid.Column="6" Tag="process:Status" Content="STATUS" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
    <Button Grid.Column="7" Tag="process:Clue" Content="DRIVER CLUE" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
</Grid>
</ListView.Header>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,4" Height="32" Background="{Binding HighlightBrush}" ColumnSpacing="12" ColumnDefinitions="175,58,80,91,80,79,215,*">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Pid}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Cpu}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Kernel}" />
                                    <TextBlock Grid.Column="4" Text="{Binding User}" />
                                    <TextBlock Grid.Column="5" Text="{Binding Ratio}" />
                                    <TextBlock Grid.Column="6" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="7" Text="{Binding Clue}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid x:Name="CauseEffectPanel" Visibility="Collapsed" RowDefinitions="Auto,Auto,*,Auto" Padding="8">
                        <TextBlock Grid.Row="0" Text="CAUSE &amp; EFFECT  ·  ETW stack associations (not proof of causation)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" x:Name="AssociationSummary" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel Grid.Row="2" Spacing="4"><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Driver" Tag="association:Driver" Click="SortColumn_Click"/><Button Content="Processes" Tag="association:Processes" Click="SortColumn_Click"/><Button Content="Evidence" Tag="association:Evidence" Click="SortColumn_Click"/></StackPanel><ListView x:Name="AssociationList" FontSize="12">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding HighlightBrush}" Padding="8,5" Margin="0,2" CornerRadius="4">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Driver}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Processes}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Evidence}" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView></StackPanel>
                        <TextBlock Grid.Row="3" Text="A driver shown in a process stack is a diagnostic clue, not proof that it caused the process's CPU usage." FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                    </Grid>

                    <ListView x:Name="FilterList" FontSize="12" Visibility="Collapsed">
                        <ListView.Header>
<Grid Padding="6,4" ColumnSpacing="20" ColumnDefinitions="260,100,80,*">
    <Button Grid.Column="0" Tag="filter:Name" Content="FILTER DRIVER" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
    <Button Grid.Column="1" Tag="filter:Instances" Content="INSTANCES" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
    <Button Grid.Column="2" Tag="filter:Frame" Content="FRAME" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
    <Button Grid.Column="3" Tag="filter:Note" Content="NOTE" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
</Grid>
</ListView.Header>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,4" Height="32" ColumnSpacing="20" ColumnDefinitions="260,100,80,*">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Instances}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Frame}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Note}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid x:Name="DriverPanel" Visibility="Collapsed" RowDefinitions="*,140">
                        <ListView x:Name="DriverList" FontSize="12" SelectionChanged="Driver_SelectionChanged">
                            <ListView.Header>
<Grid Padding="6,4" ColumnSpacing="14" ColumnDefinitions="240,92,92,80,*">
    <Button Grid.Column="0" Tag="driver:Name" Content="DRIVER" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
    <Button Grid.Column="1" Tag="driver:Dpc" Content="DPC (ms)" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
    <Button Grid.Column="2" Tag="driver:Isr" Content="ISR (ms)" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
    <Button Grid.Column="3" Tag="driver:Samples" Content="SAMPLES" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
    <Button Grid.Column="4" Tag="driver:Level" Content="ASSESSMENT" Click="SortColumn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" />
</Grid>
</ListView.Header>
                            <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="6,4" Height="32" Background="{Binding HighlightBrush}" ColumnSpacing="14" ColumnDefinitions="240,92,92,80,*">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Dpc}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Isr}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Samples}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Level}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="DriverExplanation" TextTrimming="CharacterEllipsis" />
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <ScrollViewer x:Name="HelpPanel" Visibility="Collapsed">
                        <Border Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <TextBlock TextWrapping="Wrap" xml:space="preserve">
KernelTraceScout - Quick Help

What this tool does
- It shows which processes use a lot of kernel CPU time.
- It can record a short ETW trace to find possible driver clues.

Buttons
- Check once: Read the current process values one time.
- Auto refresh: Repeat the process check automatically.
- Reload filters: Refresh the loaded file system filter list.
- Export CSV: Save the current view to a CSV file.
- Analyze (ETW): Start a short ETW trace. ETW means Event Tracing for Windows.
- Demo: Show example data. This does not scan your PC.

Tabs
- Processes: Running processes and CPU usage.
- File System Filters: Loaded file system filter drivers.
- Driver / Stack Analysis: Driver clues from ETW data.
- About: Version and author information.

Important
- A driver clue is not proof. It only tells you where to look next.
                            </TextBlock>
                        </Border>
                    </ScrollViewer>

                    <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed">
                        <Border Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="KernelTraceScout" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Version 0.9.1" />
                                <TextBlock Text="Author: Daniel Capilla" />
                                <HyperlinkButton Content="GitHub repository" Click="Repository_Click" Padding="0" HorizontalAlignment="Left" />
                                <TextBlock Text="Kernel CPU diagnostics and ETW driver analysis for Windows." TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <TextBlock Grid.Row="2"
                           x:Name="Status"
                           Margin="2,0,2,0"
                           Opacity="0.8"
                           Text="Ready." />
            </Grid>
        </NavigationView>

        <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" Severity="Informational" IsClosable="True" />
    </Grid>
</Window>

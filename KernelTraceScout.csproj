<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- SSOT: .NET Framework 4.8 is the default; -p:BuildNet10=true enables the future build. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(BuildNet10)' != 'true'">net48</TargetFramework>
    <TargetFramework Condition="'$(BuildNet10)' == 'true'">net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>KernelTraceScout.Program</StartupObject>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <ApplicationIcon>KernelTraceScout.ico</ApplicationIcon>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.0</FileVersion>
    <Version>0.9.0</Version>
    <Authors>Daniel Capilla</Authors>
    <Company>Daniel Capilla</Company>
    <Copyright>Copyright (c) 2026 Daniel Capilla</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/UncleRiot/KernelTraceScout</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="KernelTraceScout.ico" />
    <Compile Include="Program.cs" />
    <Compile Include="NativeEtw.cs" />
    <Compile Include="ProcessMonitor.cs" />
    <Compile Include="LocalSelfTest.cs" />
    <Compile Include="CaptureWatchdog.cs" />
    <Compile Include="ProfilePrivilege.cs" />
    <None Update="KernelTraceScout.config.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

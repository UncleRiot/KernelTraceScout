<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icons\KernelTraceScout.ico</ApplicationIcon>
    <RootNamespace>KernelTraceScout</RootNamespace>
    <AssemblyName>KernelTraceScout</AssemblyName>
    <Version>0.9.1</Version>
    <AssemblyVersion>0.9.1.0</AssemblyVersion>
    <FileVersion>0.9.1.0</FileVersion>
    <InformationalVersion>0.9.1</InformationalVersion>
    <Authors>Daniel Capilla</Authors>
    <Company>Daniel Capilla</Company>
    <Product>KernelTraceScout</Product>
    <Title>KernelTraceScout</Title>
    <Description>Windows kernel CPU diagnostics and ETW driver analysis</Description>
    <Copyright>Copyright (c) 2026 Daniel Capilla</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Icons\Sun.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Icons\Moon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Icons\KernelTraceScout.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="KernelTraceScout.config.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
